HOST=127.0.0.1
PORT=8000

# Required API credentials
OPENAI_API_KEY=your-openai-api-key-here

# App display
APP_TITLE=TNT Check AI
BRAND_LABEL=TNT Paper Review
SUPPORTED_EXTENSIONS=docx,pdf

# OpenAI structure-review settings
DEFAULT_LLM_MODEL=gpt-4.1-mini
DEFAULT_MIN_CONFIDENCE=0.70
OPENAI_MAX_TOKENS=3000
OPENAI_TEMPERATURE=0.0

# Runtime settings
LOG_LEVEL=INFO
MAX_WORKERS=3
STRUCTURE_TIMEOUT_SECONDS=120
TEMP_CLEANUP_TTL_SECONDS=7200

# Document preview settings
LIBREOFFICE_PATH=
DOCX_PREVIEW_TIMEOUT_SECONDS=60
PDF_PREVIEW_SCALE=2.5

# Metadata extraction API (main.py / FastAPI)
MAX_INPUT_CHARS=60000


# Matching Engine
MATCH_TOP_K=5
MATCH_SEMANTIC_WEIGHT=0.8
MATCH_LEXICAL_WEIGHT=0.2
MATCH_SUITABLE_THRESHOLD=0.7
MATCH_REVIEW_THRESHOLD=0.55
MATCH_SUITABLE_AVERAGE_THRESHOLD=0.62
MATCH_REVIEW_AVERAGE_THRESHOLD=0.48
MATCH_REFRESH_INTERVAL_DAYS=90
MATCH_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
MATCH_INDEX_DIR=data/index