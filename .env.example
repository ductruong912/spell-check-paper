# Required API credentials
OPENAI_API_KEY=your-openai-api-key-here
DEFAULT_LLM_MODEL=gpt-4.1-mini
DEFAULT_MIN_CONFIDENCE=0.70

TURNITIN_API_KEY=your-turnitin-api-key-here
TURNITIN_API_SECRET=your-turnitin-api-secret-here

# Optional runtime configuration.
# Resolution order: .env > built-in defaults in src/utils/config.py.
LOG_LEVEL=INFO
MAX_WORKERS=3

# Turnitin/iThenticate
TURNITIN_BASE_URL=https://api.turnitin.com/api/v1
TURNITIN_DEFAULT_TIMEOUT_SECONDS=900
TURNITIN_REPORT_POLL_INTERVAL=10
MAX_WORDS_PER_SUBMISSION=100000
TURNITIN_SEARCH_INTERNET=true
TURNITIN_SEARCH_PUBLICATIONS=true
TURNITIN_EXCLUDE_QUOTES=true
TURNITIN_EXCLUDE_BIBLIOGRAPHY=true

# Spell checking
REF_TAIL_WINDOW=0.30
MAX_SUGGESTIONS=5
WORD_CACHE_SIZE=10000
SPELL_CHECK_BATCH_SIZE=50

# UI display
MAX_PLAGIARISM_FINDINGS_DISPLAY=20
PLAGIARISM_PREVIEW_LENGTH=300
HIGHLIGHT_COLOR=#ffeb3b
HIGHLIGHT_TEXT_COLOR=#000
HIGHLIGHT_ERROR_COLOR=#ff5252
HIGHLIGHT_ERROR_TEXT_COLOR=#fff