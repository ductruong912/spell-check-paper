HOST=127.0.0.1
PORT=8000

# Required API credentials
OPENAI_API_KEY=your-openai-api-key-here

# App display
APP_TITLE=TNT Check AI
BRAND_LABEL=TNT Paper Review
SUPPORTED_EXTENSIONS=docx,pdf

# OpenAI structure-review settings
DEFAULT_LLM_MODEL=gpt-4.1-mini
DEFAULT_MIN_CONFIDENCE=0.70
OPENAI_MAX_TOKENS=3000
OPENAI_TEMPERATURE=0.0

# Runtime settings
LOG_LEVEL=INFO
MAX_WORKERS=3
STRUCTURE_TIMEOUT_SECONDS=120
TEMP_CLEANUP_TTL_SECONDS=7200

# Document preview settings
LIBREOFFICE_PATH=
DOCX_PREVIEW_TIMEOUT_SECONDS=60
PDF_PREVIEW_SCALE=2.5

# Metadata extraction API (main.py / FastAPI)
MAX_INPUT_CHARS=60000


# Field relevance check (so title + keywords với danh mục từ khóa lĩnh vực)
# Danh mục được nạp qua API: POST /field-keywords/upload (file mỗi dòng 1 từ khóa),
# rồi embed + lưu vào vector store (Chroma) tại đường dẫn dưới đây.
FIELD_VECTOR_STORE_PATH=data/field_vector_store
FIELD_COLLECTION_NAME=field_keywords
FIELD_SEMANTIC_WEIGHT=1.0
FIELD_LEXICAL_WEIGHT=0.0
FIELD_SUITABLE_THRESHOLD=0.50
FIELD_REVIEW_THRESHOLD=0.45
# Đã so sánh bge-base/SPECTER/e5: MiniLM tách in-field/off-field tốt nhất
# (Cohen's d 3.4) lại nhẹ + nhanh + đa ngữ. Đổi model -> upload lại danh mục +
# chạy lại matching/scripts/calibrate_field_thresholds.py để hiệu chỉnh ngưỡng.
FIELD_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Tiền tố model (e5 cần "query: "); để trống cho MiniLM/bge/SPECTER.
FIELD_MODEL_PREFIX=


# So title + keywords bản thảo với KHO BÀI BÁO HỢP LỆ
# Nạp kho qua API: POST /valid-papers/ingest (list {title, keywords[]}); so khớp
# qua POST /valid-papers/match. Điểm mỗi mặt = 0.7 cosine + 0.3 BM25, lấy trung
# bình top_k bản ghi cao điểm nhất. Dùng chung FIELD_MODEL_NAME/PREFIX ở trên.
VALID_PAPER_STORE_PATH=data/valid_paper_store
VALID_TITLE_COLLECTION=valid_titles
VALID_KEYWORD_COLLECTION=valid_keywords
VALID_SEMANTIC_WEIGHT=0.7
VALID_LEXICAL_WEIGHT=0.3
VALID_TOP_K=5
VALID_SUITABLE_THRESHOLD=0.50