# ==========================================================
# Server
# ==========================================================
HOST=127.0.0.1
PORT=8000

# ==========================================================
# API Credentials
# ==========================================================
# OpenAI API key
OPENAI_API_KEY=your-openai-api-key-here
DEFAULT_LLM_MODEL=gpt-4.1-mini

# ==========================================================
# Application
# ==========================================================
APP_TITLE=TNT Check AI
BRAND_LABEL=TNT Paper Review
SUPPORTED_EXTENSIONS=docx,pdf

# ==========================================================
# OpenAI - Structure Review
# ==========================================================
# Minimum confidence to accept result
DEFAULT_MIN_CONFIDENCE=0.70

# Generation settings
OPENAI_MAX_TOKENS=3000
OPENAI_TEMPERATURE=0.0

# ==========================================================
# Runtime
# ==========================================================
LOG_LEVEL=INFO
MAX_WORKERS=3

# Task timeout
STRUCTURE_TIMEOUT_SECONDS=120

# Temp file cleanup (seconds)
TEMP_CLEANUP_TTL_SECONDS=7200

# ==========================================================
# Document Preview
# ==========================================================
# LibreOffice executable (leave empty if in PATH)
LIBREOFFICE_PATH=

# Preview timeout
DOCX_PREVIEW_TIMEOUT_SECONDS=60

# PDF render scale
PDF_PREVIEW_SCALE=2.5

# Vector database
VALID_PAPER_STORE_PATH=data_valid_paper_store
VALID_TITLE_COLLECTION=valid_titles
VALID_KEYWORD_COLLECTION=valid_keywords

# Similarity score weights
VALID_TITLE_SEMANTIC_WEIGHT=0.6
VALID_TITLE_LEXICAL_WEIGHT=0.4

VALID_KEYWORD_SEMANTIC_WEIGHT=0.3
VALID_KEYWORD_LEXICAL_WEIGHT=0.7

# Final score weights
VALID_TITLE_SCORE_WEIGHT=0.4
VALID_KEYWORD_SCORE_WEIGHT=0.6

# Retrieval settings
VALID_TOP_K=5
VALID_EVAL_TOP_N=3
VALID_RETRIEVAL_SCORE_WEIGHT=0.4
VALID_RERANKER_SCORE_WEIGHT=0.6

# Decision threshold
VALID_SUITABLE_THRESHOLD=0.50

# Embedding model
VALID_MODEL_NAME=BAAI/bge-small-en-v1.5
VALID_RERANKER_MODEL_NAME=cross-encoder/stsb-distilroberta-base
EMBEDDING_BATCH_SIZE=32
# 0 keeps PyTorch's default CPU thread setting.
TORCH_NUM_THREADS=0

# ==========================================================
# Reviewer Recommendation
# ==========================================================
REVIEWER_STORE_PATH=data_reviewer_store
REVIEWER_COLLECTION=reviewer_profiles
REVIEWER_RERANKER_MODEL_NAME=cross-encoder/stsb-distilroberta-base
